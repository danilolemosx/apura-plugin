+    //==============================================================================
+    // AudioSuite de clip inteiro (remendo do Apura; ver AAXClientExtensions::usesWholeClipAudioSuite).
+    // O Avid entrega a selecao por acesso aleatorio; o plug-in processa tudo de uma vez
+    // e o resultado volta janela por janela.
+    class JuceAAX_HostProcessor final : public AAX_CHostProcessor
+    {
+    public:
+        static AAX_CHostProcessor* AAX_CALLBACK Create() { return new JuceAAX_HostProcessor(); }
+
+        AAX_Result PreRender (int32_t, int32_t, int32_t) override
+        {
+            pronto = false;
+            return AAX_SUCCESS;
+        }
+
+        AAX_Result PostRender() override
+        {
+            pronto = false;
+            resultado = AudioBuffer<float>();
+            return AAX_SUCCESS;
+        }
+
+        AAX_Result RenderAudio (const float* const inAudioIns[], int32_t inAudioInCount,
+                                float* const iAudioOuts[], int32_t iAudioOutCount, int32_t* ioWindowSize) override
+        {
+            if (ioWindowSize == nullptr)
+                return AAX_ERROR_NULL_ARGUMENT;
+
+            if (! pronto)
+            {
+                const auto r = processarSelecao (inAudioIns, inAudioInCount);
+
+                if (r != AAX_SUCCESS)
+                    return r;
+
+                pronto = true;
+            }
+
+            const auto inicio = GetLocation();
+            const auto janela = *ioWindowSize;
+            const auto total = (int64_t) resultado.getNumSamples();
+
+            for (int32_t c = 0; c < iAudioOutCount; ++c)
+            {
+                auto* out = iAudioOuts[c];
+
+                if (out == nullptr)
+                    continue;
+
+                std::fill (out, out + janela, 0.0f);
+
+                if (c < resultado.getNumChannels() && inicio >= 0 && inicio < total)
+                    std::copy_n (resultado.getReadPointer (c, (int) inicio), (size_t) jmin<int64_t> (janela, total - inicio), out);
+            }
+
+            return AAX_SUCCESS;
+        }
+
+        AAX_Result GetClipNameSuffix (int32_t inMaxLength, AAX_IString* outString) const override
+        {
+            if (auto* p = plugin(); p != nullptr && outString != nullptr)
+            {
+                const auto sufixo = p->getAAXClientExtensions().getWholeClipNameSuffix();
+
+                if (sufixo.isNotEmpty() && sufixo.length() <= inMaxLength)
+                {
+                    outString->Set (sufixo.toRawUTF8());
+                    return AAX_SUCCESS;
+                }
+            }
+
+            return AAX_CHostProcessor::GetClipNameSuffix (inMaxLength, outString);
+        }
+
+    private:
+        AudioProcessor* plugin() const
+        {
+            auto* parametros = dynamic_cast<const JuceAAX_Processor*> (GetEffectParameters());
+            return parametros != nullptr ? &parametros->getPluginInstance() : nullptr;
+        }
+
+        AAX_Result processarSelecao (const float* const inAudioIns[], int32_t inAudioInCount)
+        {
+            auto* p = plugin();
+            float taxa = 0.0f;
+
+            if (p == nullptr || Controller() == nullptr || Controller()->GetSampleRate (&taxa) != AAX_SUCCESS || taxa <= 0.0f)
+                return AAX_ERROR_NULL_OBJECT;
+
+            const auto n = GetInputRange();
+
+            if (n <= 0 || n > (int64_t) std::numeric_limits<int>::max())
+                return AAX_ERROR_INVALID_ARGUMENT;
+
+            resultado.setSize (inAudioInCount, (int) n);
+            resultado.clear();
+
+            for (int64_t pos = 0; pos < n;)
+            {
+                auto lidas = (int32_t) jmin<int64_t> (n - pos, 1 << 16);
+                const auto r = GetAudio (inAudioIns, inAudioInCount, pos, &lidas);
+
+                if (r != AAX_SUCCESS)
+                    return r;
+
+                if (lidas <= 0)
+                    break; // fim do material: o resto fica em silencio
+
+                for (int32_t c = 0; c < inAudioInCount; ++c)
+                    if (inAudioIns[c] != nullptr)
+                        resultado.copyFrom (c, (int) pos, inAudioIns[c], lidas);
+
+                pos += lidas;
+            }
+
+            return p->getAAXClientExtensions().processWholeClip (resultado, (double) taxa) ? AAX_SUCCESS
+                                                                                            : AAX_ERROR_PLUGIN_BEGIN - 1;
+        }
+
+        AudioBuffer<float> resultado;
+        bool pronto = false;
+    };
+
