+    //==============================================================================
+    /*  AudioSuite de clip inteiro (remendo do Apura; nao faz parte do JUCE oficial).
+
+        Quando usesWholeClipAudioSuite() devolve true, o plug-in AAX ganha um Host
+        Processor: no AudioSuite, o Avid entrega a selecao inteira, com todos os canais
+        juntos, e processWholeClip() trata tudo de uma vez antes de devolver o resultado.
+        Isso permite medir o clip inteiro (loudness, por exemplo) antes de processar.
+    */
+    virtual bool usesWholeClipAudioSuite() const { return false; }
+
+    /** Recebe a selecao inteira e devolve o resultado no mesmo buffer. false = erro. */
+    virtual bool processWholeClip (AudioBuffer<float>& audio, double sampleRate)
+    {
+        ignoreUnused (audio, sampleRate);
+        return false;
+    }
+
+    /** Sufixo do nome do clip novo criado pelo AudioSuite (vazio = o padrao do Avid). */
+    virtual String getWholeClipNameSuffix() const { return {}; }
